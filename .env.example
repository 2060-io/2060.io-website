# Copy to .env.local for local development (.env* is gitignored).
# In production these come from the k8s `2060-website-secrets` Secret, which
# the deploy workflows populate from GitHub Actions secrets — do NOT ship a
# .env file.

# ─── Public site ─────────────────────────────────────────────────────────────
# The /contact form emails inquiries to all data-room admins and VC admins
# over SMTP (MAIL_* below) — no CRM involved.

# Optional: Discord/Slack-compatible webhook for best-effort ops alerts when
# contact-form delivery fails. Leave empty to log to stderr only.
ALERT_WEBHOOK_URL=

# ─── Data room (invitation-only; /login, /dataroom, /vc-admin, /admin) ──────
# Postgres. Local dev points at the docker/ compose Postgres (npm run db:up),
# which listens on 5433 to avoid clashing with other local instances.
DATABASE_URL=postgresql://dataroom:dataroom@localhost:5433/dataroom?schema=public

# Auth.js (NextAuth v5). AUTH_SECRET: generate with `openssl rand -base64 32`.
AUTH_SECRET=
AUTH_URL=http://localhost:3000
# OAuth providers (verified-email sign-in). Create apps in Google / GitHub with
# the callback URLs {AUTH_URL}/api/auth/callback/google|github.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Transactional email over SMTP (sign-in codes; later: invitations, NDA copy).
# Gmail/Workspace needs an App Password — enable 2FA on the account, then
# create one at https://myaccount.google.com/apppasswords. MAIL_PORT 587 =
# STARTTLS, 465 = SSL (or set MAIL_ENCRYPTION=ssl).
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=
MAIL_FROM_ADDRESS=no-reply@2060.io
MAIL_FROM_NAME=2060
# Optional overrides for the email header logos (2060 + Verana Foundation).
# Unset → the PNGs this site ships at {AUTH_URL}/assets/email/. Only set these
# to point at different hosted rasters.
EMAIL_LOGO_URL=
EMAIL_VERANA_LOGO_URL=

# Bootstrap admin emails (comma-separated) seeded into the admin allowlist on
# first run (npm run db:seed). After bootstrap, admins are managed in /admin.
ADMIN_BOOTSTRAP_EMAILS=

# Optional: which legal/ version file the seed activates as the data-room NDA
# (admins can switch versions in /admin/nda). Defaults to nda-v1.md.
NDA_FILENAME=nda-v1.md

# Filesystem storage for data-room binaries (signed NDA PDFs, documents). In
# production this is a mounted PVC; locally it defaults to ./var/storage.
STORAGE_DIR=

# ── VC meetings (Google Meet) ────────────────────────────────────────────────
# A Google Cloud service account with DOMAIN-WIDE DELEGATION impersonates the
# meetings role account (GOOGLE_CALENDAR_IMPERSONATE), which organizes every
# call: Google auto-creates the Meet link and sends the invitations. In the
# Workspace Admin console, authorize the service account's client ID for BOTH
# scopes:
#   https://www.googleapis.com/auth/calendar.events
#   https://www.googleapis.com/auth/calendar.freebusy
# 2060-side attendees must share their calendars (free/busy visibility is
# enough) with the meetings account so availability can be checked.
# GOOGLE_SA_PRIVATE_KEY: the PEM private key; literal \n line breaks are fine.
GOOGLE_SA_EMAIL=
GOOGLE_SA_PRIVATE_KEY=
GOOGLE_CALENDAR_IMPERSONATE=meetings@2060.io
