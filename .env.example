# Copy to .env.local for local development (.env* is gitignored).
# In production these come from the chart (RELATICLE_API_URL) and the k8s
# `2060-website-secrets` Secret, which the deploy workflows populate from
# GitHub Actions secrets — do NOT ship a .env file.

# ─── Public site ─────────────────────────────────────────────────────────────
# Relaticle CRM — the /contact form posts inquiries here.
# Locally you can point at the public instance; in-cluster the deployment uses
# http://relaticle.relaticle.svc.cluster.local
RELATICLE_API_URL=https://crm.2060.io
RELATICLE_API_TOKEN=

# Optional: Discord/Slack-compatible webhook for best-effort ops alerts when a
# CRM write fails. Leave empty to log to stderr only.
ALERT_WEBHOOK_URL=

# ─── Data room (invitation-only; /login, /dataroom, /vc-admin, /admin) ──────
# Postgres. Local dev points at the docker/ compose Postgres (npm run db:up),
# which listens on 5433 to avoid clashing with other local instances.
DATABASE_URL=postgresql://dataroom:dataroom@localhost:5433/dataroom?schema=public

# Auth.js (NextAuth v5). AUTH_SECRET: generate with `openssl rand -base64 32`.
AUTH_SECRET=
AUTH_URL=http://localhost:3000
# OAuth providers (verified-email sign-in). Create apps in Google / GitHub with
# the callback URLs {AUTH_URL}/api/auth/callback/google|github.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Transactional email over SMTP (sign-in codes; later: invitations, NDA copy).
# Gmail/Workspace needs an App Password — enable 2FA on the account, then
# create one at https://myaccount.google.com/apppasswords. MAIL_PORT 587 =
# STARTTLS, 465 = SSL (or set MAIL_ENCRYPTION=ssl).
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=
MAIL_FROM_ADDRESS=no-reply@2060.io
MAIL_FROM_NAME=2060
# Optional: absolute URLs of hosted raster (PNG) logos for email headers —
# 2060's and the Verana Foundation's. Unset → styled text wordmarks (SVG/remote
# images render unreliably in many email clients, so prefer small PNGs).
EMAIL_LOGO_URL=
EMAIL_VERANA_LOGO_URL=

# Bootstrap admin emails (comma-separated) seeded into the admin allowlist on
# first run (npm run db:seed). After bootstrap, admins are managed in /admin.
ADMIN_BOOTSTRAP_EMAILS=

# Optional: which legal/ version file the seed activates as the data-room NDA
# (admins can switch versions in /admin/nda). Defaults to nda-v1.md.
NDA_FILENAME=nda-v1.md

# Filesystem storage for data-room binaries (signed NDA PDFs, documents). In
# production this is a mounted PVC; locally it defaults to ./var/storage.
STORAGE_DIR=
