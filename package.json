{
  "name": "2060-io-website",
  "version": "2.5.1",
  "private": true,
  "description": "The 2060.io website (Next.js + Tailwind v4).",
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "db:up": "docker compose -f docker/compose.yaml up -d",
    "db:down": "docker compose -f docker/compose.yaml down",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "node prisma/seed.mjs",
    "db:studio": "prisma studio",
    "test": "vitest run"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@prisma/client": "^6.19.3",
    "next": "^16.2.4",
    "next-auth": "^5.0.0-beta.31",
    "nodemailer": "^7.0.13",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.7",
    "@types/node": "^22.13.5",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "eslint": "^9.21.0",
    "eslint-config-next": "^16.2.4",
    "postcss": "^8.5.3",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.0.7",
    "typescript": "^5.7.3",
    "vitest": "^3.2.7"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "esbuild@0.28.2": true,
    "prisma@6.19.3": true,
    "unrs-resolver@1.11.1": true,
    "sharp@0.34.5": true,
    "@prisma/engines@6.19.3": true
  }
}
