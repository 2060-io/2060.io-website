// 2060.io — investor data room
// Accounts are invitation-only (see auth.ts): an email can sign in only when it
// is on one of the role tables below (admin allowlist, VC-admin allowlist, or a
// VC invitation). Roles are resolved per request from the verified email.
//
// Conventions (shared with the veranafoundation.org codebase this is ported
// from): cuid() ids, UTC DateTimes, explicit relations.

generator client {
  provider      = "prisma-client-js"
  // "native" for local dev; the musl/openssl-3 target is for the node:22-alpine runtime.
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// Auth.js (NextAuth v5) standard models — field names are required by the adapter
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String? // provider-supplied; refreshed on OAuth sign-in
  email         String?   @unique // the verified email is the identity key
  emailVerified DateTime?
  image         String?

  accounts     Account[]
  sessions     Session[]
  adminActions AdminAction[]
  apiTokens    ApiToken[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String // "google" | "github" | "email" (OTP)
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String // email OTP
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─────────────────────────────────────────────────────────────────────────────
// Roles — an email's presence on a table IS the role grant
// ─────────────────────────────────────────────────────────────────────────────

/// ADMIN: full access — manages admins, VC admins, and the NDA. Bootstrapped
/// from ADMIN_BOOTSTRAP_EMAILS (prisma/seed.mjs), then managed in /admin.
model AdminAllowlistEntry {
  id            String   @id @default(cuid())
  email         String   @unique // stored lowercased
  addedByUserId String?
  addedAt       DateTime @default(now())
}

/// VC_ADMIN: runs the data room — invitations, documents, per-VC document
/// selection, activity, the invitation-email template. Added by ADMINs.
model VcAdminEntry {
  id            String   @id @default(cuid())
  email         String   @unique // stored lowercased
  addedByUserId String?
  addedAt       DateTime @default(now())
}

// ─────────────────────────────────────────────────────────────────────────────
// VC organizations & invitations
// ─────────────────────────────────────────────────────────────────────────────

/// A VC firm. Several invited emails can belong to one org; the NDA is signed
/// once per org.
model Org {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())

  invites      VcInvite[]
  ndaSignature NdaSignature?
  meetings     Meeting[]
}

/// An invited VC email. Its presence is what lets that email sign in as a VC.
model VcInvite {
  id              String    @id @default(cuid())
  email           String    @unique // stored lowercased
  orgId           String
  invitedByUserId String?
  invitedAt       DateTime  @default(now())
  lastLoginAt     DateTime? // refreshed on every sign-in (events.signIn)

  org            Org             @relation(fields: [orgId], references: [id], onDelete: Cascade)
  documentGrants DocumentGrant[]
  meetings       Meeting[]
}

// ─────────────────────────────────────────────────────────────────────────────
// Document repository — per-VC visibility, downloads audited
// ─────────────────────────────────────────────────────────────────────────────

/// A data-room document. The row (its id) is the durable identity; replacing
/// the content bumps `version` and writes a new file under the same id, so
/// grants and download history survive updates. Old files are retained on the
/// volume for audit; only the latest is served.
model Document {
  id          String   @id @default(cuid())
  /// "file" (uploaded, downloadable) or "url" (external link, opens in a new
  /// window). URL entries are always visible to every invited email and carry
  /// empty file fields.
  kind        String   @default("file")
  title       String // for URL entries this is the label
  url         String? // URL entries only
  filename    String // original upload name (of the latest version)
  contentType String
  size        Int
  storageKey  String // documents/<id>/v<version>-<filename>
  version     Int      @default(1)
  /// true → every invited email sees it (no per-email grant needed);
  /// false → visible only to emails granted individually. Forced true for
  /// URL entries.
  alwaysVisible Boolean @default(false)
  /// Position in the lists VCs and staff see: ascending, with unordered
  /// (null) entries after the ordered ones, newest first. Set by VC admins.
  sortOrder   Int?
  /// Preview shown in the lists: storage key of a WebP under documents/<id>/,
  /// null when there is none. `thumbnailSource` is "auto" (rendered from the
  /// file: PDF or Markdown page 1, or the image itself) or "custom" (uploaded
  /// by a VC admin; kept when the content is replaced).
  thumbnailKey    String?
  thumbnailSource String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  updatedBy   String? // email of the VC admin who last uploaded

  grants    DocumentGrant[]
  downloads DownloadEvent[]
}

/// Visibility grant: this invited email sees this document in the data room.
/// Nothing is visible without a grant.
model DocumentGrant {
  id         String   @id @default(cuid())
  inviteId   String
  documentId String
  grantedBy  String? // email of the VC admin who granted
  grantedAt  DateTime @default(now())

  invite   VcInvite @relation(fields: [inviteId], references: [id], onDelete: Cascade)
  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([inviteId, documentId])
}

/// One row per VC access to a repository entry. `documentTitle` is copied at
/// access time so the audit trail survives document deletion (the FK then
/// nulls). `action`: "download" (file saved), "view" (opened inline in the
/// browser), "open" (URL entry followed).
model DownloadEvent {
  id            String   @id @default(cuid())
  email         String // the downloader's (invite) email
  documentId    String?
  documentTitle String
  action        String   @default("download")
  at            DateTime @default(now())

  document Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@index([email, at])
}

// ─────────────────────────────────────────────────────────────────────────────
// NDA — versioned template catalog + one signature per org
// ─────────────────────────────────────────────────────────────────────────────

/// Catalog of NDA template versions. The legal/ directory is the source of
/// truth (one Markdown file per version, added, never edited); each row pins a
/// filename to the sha384 it had when first activated, so a version can never
/// silently change. Exactly one row is active at a time (see nda-versions.ts).
model NdaDocument {
  id            String   @id @default(cuid())
  filename      String   @unique // e.g. "nda-v1.md" in legal/
  version       String // display label, e.g. "v1"
  hash          String // sha384 (SRI form) pinned at first activation
  active        Boolean  @default(false)
  effectiveFrom DateTime @default(now())

  signatures NdaSignature[]
}

/// A signed NDA. One per org (@unique): the first invited VC of an org signs
/// for everyone invited under that org.
model NdaSignature {
  id            String   @id @default(cuid())
  orgId         String   @unique
  ndaDocumentId String
  signerUserId  String?
  signerEmail   String
  signerName    String
  signedAt      DateTime @default(now())
  pdfPath       String? // storage key of the rendered signed PDF
  pdfHash       String? // sha384 (SRI form) of that exact PDF

  org         Org         @relation(fields: [orgId], references: [id], onDelete: Cascade)
  ndaDocument NdaDocument @relation(fields: [ndaDocumentId], references: [id])
}

// ─────────────────────────────────────────────────────────────────────────────
// Invitation email template — one row, editable by VC admins
// ─────────────────────────────────────────────────────────────────────────────

/// The customizable invitation email. Markdown body with {{org_name}},
/// {{email}}, {{login_url}} placeholders; rendered inside the dual-logo
/// (2060 + Verana Foundation) email shell. A code default applies until the
/// first save creates the row (id "default").
model InviteEmailTemplate {
  id           String   @id @default("default")
  subject      String
  bodyMarkdown String   @db.Text
  updatedBy    String?
  updatedAt    DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────────────────────
// Audit trail of privileged actions
// ─────────────────────────────────────────────────────────────────────────────

model AdminAction {
  id          String   @id @default(cuid())
  actorUserId String
  actorEmail  String
  action      String // e.g. "admin.add", "vcadmin.remove"
  targetType  String?
  targetId    String?
  before      Json?
  after       Json?
  at          DateTime @default(now())

  actor User @relation(fields: [actorUserId], references: [id])
}

// ─────────────────────────────────────────────────────────────────────────────
// VC meetings — 30-minute Google Meet calls booked from the data room
// ─────────────────────────────────────────────────────────────────────────────

/// Booking configuration (single row, id "default"), managed in
/// /vc-admin/meetings. Days and time windows are interpreted in GMT.
model MeetingSettings {
  id             String   @id @default("default")
  enabled        Boolean  @default(false)
  openDays       Json // e.g. ["TUE","WED","THU"]
  windows        Json // e.g. [{"start":"12:00","end":"15:00"}] (GMT)
  attendeeEmails Json // 2060/Verana-side attendees, e.g. ["fabrice@2060.io"]
  horizonDays    Int      @default(14) // how far ahead VCs can book
  minNoticeHours Int      @default(24) // earliest bookable slot from now
  updatedBy      String?
  updatedAt      DateTime @updatedAt
}

/// A booked call. The slot is reserved by the DB row (unique startAt) before
/// the Google event is created; rows are deleted on cancellation.
model Meeting {
  id            String   @id @default(cuid())
  inviteId      String
  email         String // booker (invite email)
  orgId         String
  startAt       DateTime @unique // GMT; 30-minute slots
  endAt         DateTime
  googleEventId String?
  meetUrl       String?
  createdAt     DateTime @default(now())

  invite VcInvite @relation(fields: [inviteId], references: [id], onDelete: Cascade)
  org    Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────────────────────────────────────
// MCP server — bearer tokens for /api/mcp (see README, "MCP server")
// ─────────────────────────────────────────────────────────────────────────────

enum ApiTokenScope {
  read
  write
}

enum ApiTokenKind {
  personal // created by hand in /account/settings
  access // OAuth connector access token (short-lived)
  refresh // OAuth connector refresh token (never a bearer)
}

/// A bearer token for the MCP server. The secret (`dr_…`) is shown once and
/// only its SHA-256 is stored; `prefix` lets the owner recognise it in the
/// list. Tokens act as their user with the role the site grants at request
/// time (VC admin or admin). `kind`, `clientId`, `grantId` and `resource` are
/// for OAuth-issued tokens: one authorization = one grantId, so revoking a
/// connected application revokes all of its tokens.
model ApiToken {
  id         String        @id @default(cuid())
  userId     String
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  tokenHash  String        @unique // sha256 hex of the secret
  prefix     String // first characters of the secret
  scope      ApiTokenScope @default(read)
  kind       ApiTokenKind  @default(personal)
  clientId   String?
  client     OAuthClient?  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  grantId    String?
  resource   String? // RFC 8707 audience the token was minted for
  lastUsedAt DateTime?
  expiresAt  DateTime?
  revokedAt  DateTime?
  createdAt  DateTime      @default(now())

  @@index([userId])
  @@index([grantId])
}

// ─────────────────────────────────────────────────────────────────────────────
// OAuth 2.1 authorization server — claude.ai connectors sign in with consent
// instead of a pasted token (see README, "MCP server")
// ─────────────────────────────────────────────────────────────────────────────

/// A registered MCP client (RFC 7591 dynamic registration, open to any
/// client — the consent screen is what protects the user). The row id is the
/// client_id. Confidential clients hold a hashed secret.
model OAuthClient {
  id                      String   @id @default(cuid())
  name                    String
  redirectUris            String[]
  secretHash              String? // sha256 of the client_secret (confidential clients only)
  tokenEndpointAuthMethod String   @default("none") // "none" | "client_secret_post" | "client_secret_basic"
  clientUri               String?
  logoUri                 String?
  createdAt               DateTime @default(now())

  codes  OAuthAuthorizationCode[]
  tokens ApiToken[]
}

/// A single-use authorization code (10 minutes), bound to client, redirect
/// URI, PKCE challenge (S256), scope and resource. Hashed like the tokens.
model OAuthAuthorizationCode {
  id                  String      @id @default(cuid())
  codeHash            String      @unique
  clientId            String
  client              OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  userId              String
  redirectUri         String
  codeChallenge       String
  codeChallengeMethod String      @default("S256")
  scope               String // space-separated: "read" | "read write"
  resource            String?
  expiresAt           DateTime
  usedAt              DateTime?
  createdAt           DateTime    @default(now())

  @@index([expiresAt])
}
